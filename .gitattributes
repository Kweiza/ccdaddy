* text=auto eol=lf

# `text=auto` guesses, and a guess that goes the wrong way rewrites line endings
# inside a PNG and corrupts it. The README banner is the first binary this
# repository has ever tracked; say so rather than trust the heuristic.
*.png binary

# The npm shim fixtures are byte-exact output from npm's own generator, and
# their CRLF line endings are the thing under test: a real claude.cmd has them,
# and `eol=lf` above would quietly convert the fixtures to something npm never
# writes. Same reasoning as the PNG — say what the file is rather than let the
# heuristic guess.
internal/cli/testdata/cmdshim/*.cmd -text

# The release-signature fixtures are byte-exact. An ed25519 signature covers the
# signed file's exact bytes — its final newline included — so `eol=lf` above
# converting one line ending would turn a valid golden signature into a test
# that fails, on whichever checkout applied the filter and nowhere else. Same
# reasoning as the npm shim fixtures: say what the file is rather than let the
# heuristic guess.
internal/relsign/testdata/** -text
